<%- include('../partials/admin-head',{title:`${artist.name} Portfolio`}) %><div class="admin-top"><div><p class="kicker">Portfolio</p><h1><%= artist.name %></h1></div><a href="/admin/artists/<%= artist.id %>/edit">← Artist Profile</a></div><form class="admin-card admin-form" action="/admin/artists/<%= artist.id %>/portfolio" method="post" enctype="multipart/form-data"><h2>Add Portfolio Images</h2><div class="form-grid"><label class="full">Images (up to 20)<input type="file" name="images" multiple accept="image/*" required></label><label>Title<input name="title"></label><label>Style<input name="style"></label><label>Placement<input name="placement"></label><label>Sort Order<input name="sort_order" type="number" value="0"></label><label class="full">Alt Text<input name="alt_text" placeholder="<%= artist.name %> tattoo portfolio image"></label><label class="full">Description<textarea name="description" rows="3"></textarea></label><label class="check"><input type="checkbox" name="featured"> Show on homepage Featured Work</label></div><button class="admin-button" type="submit">Upload Images</button></form><div class="portfolio-admin-grid"><% portfolio.forEach(p=>{ %><article class="portfolio-admin-item"><img src="<%= p.image_path %>"><div><strong><%= p.title||'Untitled' %></strong><small><%= p.style %> <%= p.featured?'· Featured':'' %></small><form action="/admin/portfolio/<%= p.id %>/delete" method="post"><button class="danger small-danger" onclick="return confirm('Delete this image?')">Delete</button></form></div></article><% }) %></div><%- include('../partials/admin-foot') %>
