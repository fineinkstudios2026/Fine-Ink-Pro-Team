<%- include('../partials/admin-head',{title:'Users'}) %><div class="admin-top"><div><p class="kicker">Administration</p><h1>Users</h1></div></div><% if(error){ %><div class="alert error"><%= error %></div><% } %><div class="admin-card"><h2>Add Admin User</h2><form class="admin-form form-grid" method="post" action="/admin/users"><label>Name<input name="name"></label><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" minlength="10" required></label><label>Role<select name="role"><option value="admin">Admin</option><option value="owner">Owner</option></select></label><div class="full"><button class="admin-button" type="submit">Create User</button></div></form></div><div class="admin-card"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th><th></th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.created_at %></td><td><form action="/admin/users/<%= u.id %>/delete" method="post"><button class="danger small-danger" onclick="return confirm('Delete this admin user?')">Delete</button></form></td></tr><% }) %></tbody></table></div><%- include('../partials/admin-foot') %>
