<%- include('../partials/admin-head',{title:'Artists'}) %><div class="admin-top"><div><p class="kicker">Content</p><h1>Artists</h1></div><a class="admin-button" href="/admin/artists/new">+ Add Artist</a></div><div class="admin-card"><table><thead><tr><th>Artist</th><th>Specialty</th><th>Order</th><th>Featured</th><th>Actions</th></tr></thead><tbody><% artists.forEach(a=>{ %><tr><td><div class="mini-artist"><% if(a.profile_image){ %><img src="<%= a.profile_image %>"><% } %><div><strong><%= a.name %></strong><small>/artists/<%= a.slug %></small></div></div></td><td><%= a.specialty %></td><td><%= a.sort_order %></td><td><%= a.featured?'Yes':'No' %></td><td class="actions-cell"><a href="/admin/artists/<%= a.id %>/edit">Edit</a><a href="/admin/artists/<%= a.id %>/portfolio">Portfolio</a><a target="_blank" href="/artists/<%= a.slug %>">View ↗</a></td></tr><% }) %></tbody></table></div><%- include('../partials/admin-foot') %>
