<%- include('../partials/admin-head',{title:artist?'Edit Artist':'Add Artist'}) %><div class="admin-top"><div><p class="kicker">Artist Profile</p><h1><%= artist?`Edit ${artist.name}`:'Add Artist' %></h1></div><a href="/admin/artists">← Back</a></div><form class="admin-form" method="post" enctype="multipart/form-data" action="<%= artist?`/admin/artists/${artist.id}/edit`:'/admin/artists/new' %>"><div class="admin-card form-grid"><label>Name<input name="name" required value="<%= artist?.name||'' %>"></label><label>URL Slug<input name="slug" value="<%= artist?.slug||'' %>" placeholder="auto-created-from-name"></label><label>Specialty<input name="specialty" value="<%= artist?.specialty||'' %>"></label><label>Location<input name="location" value="<%= artist?.location||'' %>"></label><label>Starting Price / Project Note<input name="starting_price" value="<%= artist?.starting_price||'' %>"></label><label>Status<select name="status"><option value="accepting" <%= artist?.status==='accepting'?'selected':'' %>>Accepting Projects</option><option value="limited" <%= artist?.status==='limited'?'selected':'' %>>Limited Availability</option><option value="closed" <%= artist?.status==='closed'?'selected':'' %>>Books Closed</option></select></label><label>Instagram URL<input name="instagram" value="<%= artist?.instagram||'' %>"></label><label>Website URL<input name="website" value="<%= artist?.website||'' %>"></label><label>Sort Order<input type="number" name="sort_order" value="<%= artist?.sort_order||0 %>"></label><label class="check"><input type="checkbox" name="featured" <%= artist?.featured?'checked':'' %>> Featured Artist</label><label class="full">Short Bio<textarea name="short_bio" rows="3"><%= artist?.short_bio||'' %></textarea></label><label class="full">Full Bio<textarea name="bio" rows="7"><%= artist?.bio||'' %></textarea></label><label class="full">Awards & Recognition<textarea name="awards" rows="4"><%= artist?.awards||'' %></textarea></label><label class="full">Conventions / Features<textarea name="conventions" rows="4"><%= artist?.conventions||'' %></textarea></label><label>Profile Image<input type="file" name="profile_image" accept="image/*"></label><label>Hero Image<input type="file" name="hero_image" accept="image/*"></label><% if(artist?.profile_image){ %><div><img class="preview-img" src="<%= artist.profile_image %>"></div><% } %><% if(artist?.hero_image){ %><div><img class="preview-img" src="<%= artist.hero_image %>"></div><% } %><label class="full">SEO Title<input name="seo_title" value="<%= artist?.seo_title||'' %>"></label><label class="full">SEO Description<textarea name="seo_description" rows="3"><%= artist?.seo_description||'' %></textarea></label></div><div class="form-actions"><button class="admin-button" type="submit">Save Artist</button><% if(artist){ %><a class="admin-button secondary" href="/admin/artists/<%= artist.id %>/portfolio">Manage Portfolio</a><button class="danger" type="submit" formaction="/admin/artists/<%= artist.id %>/delete" formmethod="post" onclick="return confirm('Delete this artist and all portfolio images?')">Delete Artist</button><% } %></div></form><%- include('../partials/admin-foot') %>
