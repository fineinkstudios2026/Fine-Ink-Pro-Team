<%- include('../partials/admin-head',{title:'Site Settings'}) %><div class="admin-top"><div><p class="kicker">Website</p><h1>Site Settings</h1></div></div><form class="admin-form" method="post" action="/admin/settings"><div class="admin-card form-grid"><label class="full">Site Name<input name="site_name" value="<%= settings.site_name %>"></label><label>Hero Eyebrow<input name="hero_eyebrow" value="<%= settings.hero_eyebrow %>"></label><label>Hero Main Title<input name="hero_title" value="<%= settings.hero_title %>"></label><label class="full">Hero Script Line<input name="hero_script" value="<%= settings.hero_script %>"></label><label class="full">Hero Heading<input name="hero_heading" value="<%= settings.hero_heading %>"></label><label class="full">Hero Body<textarea name="hero_body" rows="4"><%= settings.hero_body %></textarea></label><label class="full">Consultation Heading<input name="consultation_heading" value="<%= settings.consultation_heading %>"></label><label class="full">External Form Embed URL<input name="consultation_embed_url" value="<%= settings.consultation_embed_url %>" placeholder="https://..."></label><label class="full">Instagram URL<input name="instagram_url" value="<%= settings.instagram_url %>"></label><label class="full">Default SEO Title<input name="meta_title" value="<%= settings.meta_title %>"></label><label class="full">Default SEO Description<textarea name="meta_description" rows="3"><%= settings.meta_description %></textarea></label></div><button class="admin-button" type="submit">Save Site Settings</button></form><%- include('../partials/admin-foot') %>
