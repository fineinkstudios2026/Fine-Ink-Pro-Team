<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof pageTitle!=='undefined'&&pageTitle?pageTitle:settings.meta_title %></title>
<meta name="description" content="<%= typeof pageDescription!=='undefined'&&pageDescription?pageDescription:settings.meta_description %>">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Bodoni+Moda:opsz,wght@6..96,400;6..96,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css"></head><body><div class="noise"></div>
<header class="site-header"><a class="brand" href="/"><img class="brand-logo" src="/assets/fine-ink-stacked-logo.png" alt="Fine Ink Studios"><small style="<%= blockStyle(blocks.header_pro_team) %>"><%= blocks.header_pro_team.value %></small></a><button class="menu-toggle" aria-label="Menu">☰</button>
<nav><a style="<%= blockStyle(blocks.nav_artists) %>" href="/#artists"><%= blocks.nav_artists.value %></a><a style="<%= blockStyle(blocks.nav_portfolio) %>" href="/#portfolio"><%= blocks.nav_portfolio.value %></a><a style="<%= blockStyle(blocks.nav_experience) %>" href="/#experience"><%= blocks.nav_experience.value %></a><a style="<%= blockStyle(blocks.nav_book) %>" href="/#consultation"><%= blocks.nav_book.value %></a></nav><a class="button small" style="<%= blockStyle(blocks.header_cta) %>" href="/#consultation"><%= blocks.header_cta.value %></a></header>