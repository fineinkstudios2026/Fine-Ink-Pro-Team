<%- include('../partials/head',{settings,pageTitle:'Pro Team Artists | Fine Ink Studios',pageDescription:'Meet the Fine Ink Studios Pro Team.'}) %><main class="inner-page"><section class="page-hero"><p class="eyebrow">Fine Ink Studios</p><h1 style="<%= blockStyle(blocks.artists_page_title) %>"><%= blocks.artists_page_title.value %></h1><p class="script" style="<%= blockStyle(blocks.artists_page_script) %>"><%= blocks.artists_page_script.value %></p></section><section class="section"><div class="artist-carousel-shell artist-directory-carousel" data-artist-carousel><button class="artist-carousel-arrow artist-carousel-prev" type="button" aria-label="Previous artists">←</button><div class="artist-grid artist-carousel-track" tabindex="0"><% artists.forEach(artist=>{ %><article class="artist-card"><a href="/artists/<%= artist.slug %>"><% if(artist.profile_image){ %><img src="<%= artist.profile_image %>" alt="<%= artist.name %>"><% }else{ %><div class="img-placeholder">ARTIST PHOTO</div><% } %><div class="artist-info"><p><%= artist.specialty %></p><h3><%= artist.name %></h3><span>View Artist →</span></div></a></article><% }) %></div><button class="artist-carousel-arrow artist-carousel-next" type="button" aria-label="Next artists">→</button></div></section></main><%- include('../partials/foot') %>