<%- include('../partials/head',{settings,pageTitle:artist.seo_title||`${artist.name} | Fine Ink Pro Team`,pageDescription:artist.seo_description||artist.short_bio||artist.bio}) %><main class="artist-page"><section class="artist-hero"><div class="artist-hero-copy"><p class="eyebrow" style="<%= blockStyle(blocks.artist_page_eyebrow) %>"><%= blocks.artist_page_eyebrow.value %></p><h1><%= artist.name %></h1><p class="script"><%= artist.specialty %></p><p><%= artist.short_bio||artist.bio %></p><a class="button" style="<%= blockStyle(blocks.artist_page_cta) %>" href="#artist-consult"><%= blocks.artist_page_cta.value %></a></div><% if(artist.hero_image){ %><img class="artist-hero-image" src="<%= artist.hero_image %>" alt="<%= artist.name %>"><% }else{ %><div class="artist-hero-image placeholder">ARTIST HERO IMAGE</div><% } %></section>
<section class="artist-about section"><div><p class="eyebrow" style="<%= blockStyle(blocks.artist_about_eyebrow) %>"><%= blocks.artist_about_eyebrow.value %></p><h2><%= artist.specialty %></h2></div><div><p><%= artist.bio %></p><% if(artist.location){ %><p><strong style="<%= blockStyle(blocks.artist_studio_label) %>"><%= blocks.artist_studio_label.value %></strong> <%= artist.location %></p><% } %><% if(artist.starting_price){ %><p><strong style="<%= blockStyle(blocks.artist_projects_label) %>"><%= blocks.artist_projects_label.value %></strong> <%= artist.starting_price %></p><% } %><% if(artist.instagram){ %><p><a style="<%= blockStyle(blocks.artist_instagram_label) %>" href="<%= artist.instagram %>" target="_blank" rel="noopener"><%= blocks.artist_instagram_label.value %></a></p><% } %></div></section>
<section class="section"><div class="section-title"><p class="eyebrow" style="<%= blockStyle(blocks.artist_selected_work) %>"><%= blocks.artist_selected_work.value %></p><h2 style="<%= blockStyle(blocks.artist_portfolio_heading) %>"><%= blocks.artist_portfolio_heading.value %></h2></div><div class="artist-portfolio"><% if(portfolio.length){ portfolio.forEach(item=>{ %><figure><img src="<%= item.image_path %>" alt="<%= item.alt_text||item.title||artist.name %>"><figcaption><%= item.title %></figcaption></figure><% }) } else { for(let i=0;i<6;i++){ %><div class="portfolio-placeholder tall">PORTFOLIO IMAGE</div><% } } %></div></section>
<% if(artist.awards||artist.conventions){ %><section class="credentials section"><% if(artist.awards){ %><div><p class="eyebrow" style="<%= blockStyle(blocks.artist_awards_label) %>"><%= blocks.artist_awards_label.value %></p><p><%= artist.awards %></p></div><% } %><% if(artist.conventions){ %><div><p class="eyebrow" style="<%= blockStyle(blocks.artist_conventions_label) %>"><%= blocks.artist_conventions_label.value %></p><p><%= artist.conventions %></p></div><% } %></section><% } %>
<section id="artist-consult" class="consultation artist-consult"><div><p class="eyebrow" style="<%= blockStyle(blocks.artist_consult_eyebrow) %>"><%= blocks.artist_consult_eyebrow.value %></p><h2 style="<%= blockStyle(blocks.artist_consult_prefix) %>"><%= blocks.artist_consult_prefix.value %> <%= artist.name %></h2></div><div class="embed-shell"><% if(settings.consultation_embed_url){ %><iframe src="<%= settings.consultation_embed_url %>" title="Consultation form"></iframe><% }else{ %><div class="form-placeholder"><strong>EXTERNAL FORM EMBED</strong><p>Add your FIcomm-connected form URL in Admin → Site Settings.</p></div><% } %></div></section></main><%- include('../partials/foot') %>